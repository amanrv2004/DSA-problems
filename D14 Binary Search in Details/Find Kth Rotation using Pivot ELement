// Given an increasing sorted rotated array arr[] of distinct integers. The array is right-rotated k times. Find the value of k.

#include <iostream>
using namespace std;

int main()
{
    int arr[] = {4, 5, 1, 2, 3};
    int n = sizeof(arr) / sizeof(arr[0]);
    int start = 0;
    int end = n - 1;
    int pivot = arr[0];
    int index;
    if (arr[0] <= arr[n - 1])
    {
        cout << "K = 0";
        return 0;
    }
    while (start <= end)
    {
        int mid = start + (end - start) / 2;
        if (arr[mid] >= pivot)
        {
            start = mid + 1;
        }
        else
        {
            index = mid;
            end = mid - 1;
        }
    }
    cout << "K = " << index << endl;

    return 0;
}